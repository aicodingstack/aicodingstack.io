  "id": "claude-code",
  "name": "Claude Code",
  "familyId": "claude-code",
  "description": "Claude Code is an AI coding assistant that integrates directly into VS Code. It provides intelligent code suggestions, explanations, and helps with debugging and code generation.",
  "translations": {
    "zh-Hans": {
      "description": "Claude Code 是一个直接集成到 VS Code 中的 AI 编码助手。提供智能代码建议、解释，并帮助调试和代码生成。"
    },
    "de": {
      "description": "Claude Code ist ein AI-Programmierassistent, der direkt in VS Code integriert ist. Bietet intelligente Codevorschläge, Erklärungen und hilft beim Debugging und bei der Code-Erstellung."
    },
    "ko": {
      "description": "Claude Code는 VS Code에 직접 통합되는 AI 코딩 어시스턴트입니다. 스마트 코드 제안, 설명을 제공하며 디버깅과 코드 생성을 도와줍니다."
    },
    "es": {
      "description": "Claude Code es un asistente IA que se integra en VS Code. Proporciona sugerencias inteligentes, explicaciones y ayuda con depuración y generación."
    },
    "fr": {
      "description": "Claude Code est un assistant IA qui s'intègre dans VS Code. Fournit suggestions intelligentes, explications et aide au débogage et génération."
    },
    "id": {
      "description": "Claude Code adalah asisten coding AI yang terintegrasi langsung ke VS Code. Menyediakan saran kode cerdas, penjelasan, dan membantu debugging dan pembuatan kode."
    },
    "ja": {
      "description": "Claude CodeはVS Codeに直接統合されるAIコーディングアシスタントです。インテリジェントなコード提案、説明を提供し、デバッグとコード生成を支援します。"
    },
    "pt": {
      "description": "Claude Code é um assistente de programação com IA integrado ao VS Code. Oferece sugestões inteligentes de código, explicações e ajuda na depuração e geração de código."
    },
    "ru": {
      "description": "Claude Code — это ИИ-помощник по программированию, который напрямую интегрируется в VS Code. Предоставляет интеллектуальные предложения кода, объяснения и помогает в отладке и генерации кода."
    },
    "tr": {
      "description": "Claude Code, VS Code'a doğrudan entegre olan bir AI kodlama asistanıdır. Akıllı kod önerileri, açıklamalar sunar ve hata ayıklama ile kod oluşturmayı destekler."
    },
    "zh-Hant": {
      "description": "Claude Code 是一個直接整合到 VS Code 中的 AI 程式設計助手。提供智慧程式碼建議、解釋，並協助除錯和程式碼產生。"
    }
  },
